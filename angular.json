{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "google-maps-autocomplete": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:application",
                    "options": {
                        "outputPath": {
                            "base": "dist"
                        },
                        "index": "src/index.html",
                        "polyfills": ["src/polyfills.ts"],
                        "tsConfig": "tsconfig.app.json",
                        "assets": ["src/favicon.ico", "src/assets"],
                        "styles": [
                            "src/styles.scss",
                            "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                            "./node_modules/prismjs/themes/prism-okaidia.css"
                        ],
                        "scripts": ["./node_modules/prismjs/prism.js", "./node_modules/prismjs/components/prism-typescript.min.js"],
                        "extractLicenses": false,
                        "sourceMap": true,
                        "optimization": false,
                        "namedChunks": true,
                        "browser": "src/main.ts"
                    },
                    "configurations": {
                        "production": {
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.prod.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": true,
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2mb",
                                    "maximumError": "5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "6kb",
                                    "maximumError": "10kb"
                                }
                            ]
                        }
                    },
                    "defaultConfiguration": ""
                },
                "build_ghpages": {
                    "builder": "@angular-devkit/build-angular:browser",
                    "options": {
                        "baseHref": "/google-maps-autocomplete/",
                        "deployUrl": "/google-maps-autocomplete/",
                        "outputPath": "dist/browser",
                        "index": "src/index.html",
                        "main": "src/main.ts",
                        "polyfills": "src/polyfills.ts",
                        "tsConfig": "tsconfig.app.json",
                        "assets": ["src/favicon.ico", "src/assets"],
                        "styles": [
                            "src/styles.scss",
                            "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                            "./node_modules/prismjs/themes/prism-okaidia.css"
                        ],
                        "scripts": ["./node_modules/prismjs/prism.js", "./node_modules/prismjs/components/prism-typescript.min.js"],
                        "vendorChunk": true,
                        "extractLicenses": false,
                        "buildOptimizer": false,
                        "sourceMap": true,
                        "optimization": false,
                        "namedChunks": true
                    },
                    "configurations": {
                        "production": {
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.prod.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": true,
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2mb",
                                    "maximumError": "5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "6kb",
                                    "maximumError": "10kb"
                                }
                            ]
                        }
                    },
                    "defaultConfiguration": ""
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "options": {
                        "buildTarget": "google-maps-autocomplete:build"
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "google-maps-autocomplete:build:production"
                        }
                    }
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "buildTarget": "google-maps-autocomplete:build"
                    }
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "src/test.ts",
                        "polyfills": "src/polyfills.ts",
                        "tsConfig": "tsconfig.spec.json",
                        "karmaConfig": "karma.conf.js",
                        "assets": ["src/favicon.ico", "src/assets"],
                        "styles": [
                            "src/styles.scss",
                            "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                            "./node_modules/prismjs/themes/prism-okaidia.css"
                        ],
                        "scripts": ["./node_modules/prismjs/prism.js", "./node_modules/prismjs/components/prism-typescript.min.js"]
                    }
                },
                "e2e": {
                    "builder": "@angular-devkit/build-angular:protractor",
                    "options": {
                        "protractorConfig": "e2e/protractor.conf.js",
                        "devServerTarget": "google-maps-autocomplete:serve"
                    },
                    "configurations": {
                        "production": {
                            "devServerTarget": "google-maps-autocomplete:serve:production"
                        }
                    }
                },
                "deploy": {
                    "builder": "angular-cli-ghpages:deploy",
                    "options": {}
                }
            }
        },
        "@timebutt/google-maps-autocomplete": {
            "projectType": "library",
            "root": "projects/timebutt/google-maps-autocomplete",
            "sourceRoot": "projects/timebutt/google-maps-autocomplete/src",
            "prefix": "lib",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:ng-packagr",
                    "options": {
                        "tsConfig": "projects/timebutt/google-maps-autocomplete/tsconfig.lib.json",
                        "project": "projects/timebutt/google-maps-autocomplete/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/timebutt/google-maps-autocomplete/tsconfig.lib.prod.json"
                        }
                    }
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "projects/timebutt/google-maps-autocomplete/src/test.ts",
                        "tsConfig": "projects/timebutt/google-maps-autocomplete/tsconfig.spec.json",
                        "karmaConfig": "projects/timebutt/google-maps-autocomplete/karma.conf.js"
                    }
                }
            }
        }
    },
    "cli": {
        "analytics": "66b4ab45-d3f5-4efa-9eee-c4a0b45e6b77"
    }
}
