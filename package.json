{
    "name": "google-maps-autocomplete",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --port 4510",
        "build": "ng build --stats-json",
        "build:client-and-server-bundles:ghpages": "npm run build:prod:ghpages && ng run google-maps-autocomplete:server:production --bundleDependencies all",
        "build:docs": "npx compodoc -p projects/angular-material-extensions/google-maps-autocomplete/tsconfig.lib.json --hideGenerator --disableCoverage -d dist/browser/doc/",
        "build:lib": "ng build @timebutt/google-maps-autocomplete",
        "build:lib:Watch": "ng build @timebutt/google-maps-autocomplete --watch",
        "build:prod": "ng build --configuration production",
        "build:prod:ghpages": "ng build --preserve-symlinks --configuration production --aot --build-optimizer --base-href /google-maps-autocomplete/ --deploy-url /google-maps-autocomplete/",
        "build:prerender": "npm run build:client-and-server-bundles && npm run compile:server && npm run generate:prerender",
        "build:prerender:ghpages": "npm run build:client-and-server-bundles:ghpages && npm run compile:server && npm run generate:prerender",
        "deploy": "ng deploy --base-href=/google-maps-autocomplete/ --no-build",
        "generate:prerender": "cd dist && node prerender",
        "test": "jest",
        "lint": "ng lint",
        "e2e": "ng e2e",
        "serve:prerender": "cd dist/browser && http-server",
        "release": "release-it",
        "test:watch": "jest --watch",
        "compile:server": "webpack --config webpack.server.config.js --progress --color",
        "build:ssr_bak": "npm run build:client-and-server-bundles && npm run compile:server",
        "serve:ssr_bak": "node dist/server",
        "build:client-and-server-bundles_bak": "ng build --configuration production && ng run google-maps-autocomplete:server:production --bundleDependencies all",
        "prerender:ghpages": "ng run google-maps-autocomplete:prerender_ghpages",
        "bundle-report": "webpack-bundle-analyzer dist/browser/stats-es2015.json",
        "serve:ssr:google-maps-autocomplete": "node dist/server/server.mjs"
    },
    "private": false,
    "dependencies": {
        "@angular-devkit/core": "^19.2.8",
        "@angular-devkit/schematics": "^19.2.8",
        "@angular/animations": "^19.2.7",
        "@angular/cdk": "^19.2.10",
        "@angular/common": "^19.2.7",
        "@angular/compiler": "^19.2.7",
        "@angular/core": "^19.2.7",
        "@angular/forms": "^19.2.7",
        "@angular/google-maps": "^19.2.10",
        "@angular/material": "^19.2.10",
        "@angular/platform-browser": "^19.2.7",
        "@angular/platform-browser-dynamic": "^19.2.7",
        "@angular/platform-server": "^19.2.7",
        "@angular/router": "^19.2.7",
        "@angular/ssr": "^19.2.8",
        "@googlemaps/js-api-loader": "^1.16.0",
        "angular-cli-ghpages": "^0.6.2",
        "express": "^4.18.2",
        "gulp": "^4.0.2",
        "http-server": "^14.1.1",
        "ngx-markdown": "^19.1.1",
        "rxjs": "^7.5.5",
        "tslib": "^2.4.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^19.2.8",
        "@angular/cli": "^19.2.8",
        "@angular/compiler-cli": "^19.2.7",
        "@angular/language-service": "^19.2.7",
        "@compodoc/compodoc": "^1.1.19",
        "@release-it/conventional-changelog": "^1.1.4",
        "@types/express": "^4.17.17",
        "@types/jest": "25.1.2",
        "@types/node": "^12.20.10",
        "browser-sync": "^3.0.0",
        "codelyzer": "^6.0.1",
        "commitplease": "^3.2.0",
        "jest": "^29.7.0",
        "jest-preset-angular": "^14.5.5",
        "ng-packagr": "^19.2.2",
        "prettier": "^3.5.3",
        "protractor": "^7.0.0",
        "release-it": "^19.0.0",
        "ts-loader": "^9.5.0",
        "ts-node": "^10.8.0",
        "tslint": "~6.1.3",
        "typescript": "~5.8.3",
        "webpack-bundle-analyzer": "^4.7.0"
    },
    "greenkeeper": {
        "ignore": [
            "@angular/animations",
            "@angular/core",
            "@angular/common",
            "@angular/compiler",
            "@angular/cdk",
            "@angular/material",
            "@angular/platform-server",
            "@angular/platform-browser",
            "@angular/platform-browser-dynamic",
            "@angular/compiler-cli",
            "webpack",
            "zone.js",
            "rxjs",
            "tslint",
            "typescript",
            "codelyzer",
            "@types/jest",
            "@types/node"
        ]
    },
    "jest": {
        "preset": "jest-preset-angular",
        "roots": [
            "src"
        ],
        "transform": {
            "^.+\\.(ts|js|html)$": "ts-jest"
        },
        "setupFilesAfterEnv": [
            "<rootDir>/src/setup-jest.ts"
        ],
        "moduleNameMapper": {
            "@app/(.*)": "<rootDir>/src/app/$1",
            "@assets/(.*)": "<rootDir>/src/assets/$1",
            "@core/(.*)": "<rootDir>/src/app/core/$1",
            "@env": "<rootDir>/src/environments/environment",
            "@src/(.*)": "<rootDir>/src/src/$1",
            "@state/(.*)": "<rootDir>/src/app/state/$1"
        },
        "globals": {
            "ts-jest": {
                "tsConfig": "<rootDir>/tsconfig.spec.json",
                "stringifyContentPathRegex": "\\.html$",
                "astTransformers": [
                    "jest-preset-angular/build/InlineFilesTransformer",
                    "jest-preset-angular/build/StripStylesTransformer"
                ]
            }
        }
    }
}
